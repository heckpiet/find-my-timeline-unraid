# Apple iCloud credentials
ICLOUD_USERNAME=your-apple-id@example.com
# Password can be stored here or in system keyring (recommended)
# ICLOUD_PASSWORD=your-password

# Polling configuration
POLL_MIN_INTERVAL=7
POLL_MAX_INTERVAL=10

# Database path (default: ./data/locations.db)
DATABASE_PATH=./data/locations.db

# Web server
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Apple iCloud credentials
ICLOUD_USERNAME=your-apple-id@example.com
# Password can be stored here or in system keyring (recommended)
# ICLOUD_PASSWORD=your-password

# Polling configuration
POLL_MIN_INTERVAL=7
POLL_MAX_INTERVAL=10
AUTH_RETRY_INTERVAL_MINUTES=5

# Database path (default: ./data/locations.db)
DATABASE_PATH=./data/locations.db

# Web server
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Set only when browser-based Apple re-authentication must be unavailable.
WEB_AUTH_DISABLED=false
# Optional environment-managed administrator password. If left empty, the WebUI
# creates a persistent salted password hash during guided setup.
# WEB_ADMIN_PASSWORD=choose-a-strong-password
WEB_AUTH_FLOW_TIMEOUT_SECONDS=600
AUTH_SESSION_LIFETIME_DAYS=90

# Container and displayed timestamp timezone
TZ=Europe/Berlin
